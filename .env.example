# -------------------------------------------------------------------
# Temp mail provider
# -------------------------------------------------------------------
# Which provider to use. Options: tempik
# To use another provider, add a module under grokforge/tempmail/providers/
# and register it there.
TEMPMAIL_PROVIDER=tempik

# Tempik settings (used when TEMPMAIL_PROVIDER=tempik)
TEMPIK_BASE=https://tempik.neroism.web.id
TEMPIK_DOMAINS=neroism.web.id,neroism.my.id,xyntaur.my.id,xyntaur.com,3sentinel.my.id,areslabx.com
# TEMPIK_DEBUG=1

